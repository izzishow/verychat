# Google OAuth 2.0 Credentials
# Google Cloud Console (https://console.cloud.google.com/apis/credentials) 에서 발급받은 값을 입력하세요.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session Secret (쿠키 서명용 비밀키)
SESSION_SECRET=verychat-super-secure-secret-key-replace-in-production

# App Base URL (기본값은 요청 호스트 기반으로 자동 감지됩니다)
# 로컬 개발: http://localhost:3000
# VeryCloud 배포: https://izzishow.verycloud.io
BASE_URL=https://izzishow.verycloud.io
